<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ankit.dhun</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/ankitbhargav/dhun/refresh.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ankitbhargav/dhun</string>

    <!-- Every Saturday (weekday 6) at 8pm local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>6</integer>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ankitbhargav/dhun/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ankitbhargav/dhun/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
